{
  "name": "@local/dsh-mathmodeling-workflow",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "数学建模竞赛工作流插件：扫描赛题文件夹、生成 workspace + CLAUDE.md、逐步派发子代理、闸门验收",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "CHANGELOG.md",
    "assets/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
